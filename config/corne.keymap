A%0A%0A%0A%0A%23000000%0A%230252c9%3B&=%0A%0A%7C%0A%0A%0A%0A%0A%0A%0A%C3%80%0AF6&_x:12.5&t=%23c90202%0A%0A%0A%0A%0A%0A%0A%0A%0A%23000000%0A%2302c922%3B&=-%0A%0A%0A%0A%0A%0A%0A%0A%0AF%0APgDwn&_t=%23000000&a:5%3B&=%0ARShift%0A%0A%0A%0A%0A%C3%87%3B&@_y:-0.21499999999999986&x:4&a:7%3B&=Win&_x:7.5&a:5%3B&=%0AAltGr%0A%0A%0A%0A%0AEsc%3B&@_r:15&rx:5&ry:5.15&y:-0.9900000000000002&t=%23c90202%0A%0A%23f2a105%0A%0A%0A%0A%0A%0A%0A%23000000%0A%2302c922&a:4%3B&=%0A%0A%2F_%0A%0A%0A%0A%0A%0A%0ASpc%0ALower%3B&@_r:30&ry:5.25&y:-1.8599999999999999&x:0.9100000000000001&t=%23000000&a:5&h:1.5%3B&=%0AAlt%0A%0A%0A%0A%0AEnter%3B&@_r:-30&rx:12.5&y:-1.8599999999999999&x:-1.9100000000000001&a:7&h:1.5%3B&=Enter%3B&@_r:-15&ry:5.15&y:-0.9900000000000002&x:-1&t=%23c90202%0A%0A%0A%0A%0A%0A%0A%0A%0A%23000000%0A%230252c9&a:4%3B&=+%0A%0A%0A%0A%0A%0A%0A%0A%0ABksp%0ARaise
*/
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include "keymap_french.h"

/ {
    macros {
    };
    combos {
        combo_activate_layer_5 {
            compatible = "zmk,combo";
            label = "activate_layer_5";
            key-positions = <&kp RET &kp LGUI>;
            timeout-ms = <2000>; // Temps avant que le combo soit considéré comme "manqué"
            bindings = <&tog 5>;
        };
    };
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        td: tapdance {
                compatible = "zmk,behavior-hold-tap";
                label = "TAPDANCE";
                #binding-cells = <2>;
                tapping-term-ms = <150>;
                quick_tap_ms = <0>;
                flavor = "tap-preferred";
                bindings = <&kp>, <&kp>;
            };
        hmo: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&mo>;
        };
        };

    keymap {
        compatible = "zmk,keymap";

        Base {
            // -----------------------------------------------------------------------------------------
            // | W    |  B  |  é  |  P  |  O  |  è  |   |  ^  |  V   |  D  |  L  |  J  | Z |
            // | TAB  |  A  |  U  |  I  |  E  |  ,  |   |  C  |  T   |  S  |  R  |  N  | M |
            // | LCTRL|  à  |  Y  |  X  |  .  |  K  |   |  '  |  Q   |  G  |  H  |  F  | C |
            //                    | GUI | SPC | LWR |   | ENT | BKSP | ESC |

            label = "Base";
            bindings = <
    &kp FR_W         &kp FR_B     &kp FR_EACU &kp FR_P &kp FR_O    &kp FR_EGRV        &kp FR_CIRC &kp FR_V    &kp FR_D  &kp FR_L  &kp FR_J  &kp FR_Z
    &hm TAB CAPSLOCK &kp FR_A     &kp FR_U  &kp FR_I   &hmo FR_E 4 &kp FR_COMM        &kp FR_C    &hmo FR_T 3 &kp FR_S  &kp FR_R  &kp FR_N  &kp FR_M
    &kp LCTRL        &kp FR_AGRV  &kp FR_Y  &kp FR_X   &kp FR_DOT  &kp FR_K           &kp FR_QUOT &kp FR_Q    &kp FR_G  &kp FR_H  &kp FR_F  &hm FR_C RSHIFT
                                            &kp LGUI &hmo SPACE 1 &hm RET LEFT_ALT    &kp RET    &hmo BSPC 2  &hm ESC RIGHT_ALT
            >;
        };

        Lower {
            // -----------------------------------------------------------------------------------------
            // |      |  !  |  @  |  #  |  $  |    %     |   |  ^  |  &  |  *  |  (  |  )  |   \   |
            // |      |  1  |  2  |  3  |  4  |    5     |   |  -  |  =  |  `  |  [  |  ]  |  "|"  |
            // |      |  6  |  7  |  8  |  9  |    0     |   |  _  |  +  |  ~  |  {  |  }  | RSHFT |
            //                     | GUI |     | ALT/ENT |   | HYPER/SPACE | BKSP |    |
            label = "Lower";
            bindings = <
    &trans  &trans  &trans   &trans       &trans       &trans         &trans  &trans   &trans   &trans    &trans        &kp BSPC
    &trans  &trans  &trans   &trans       &kp LC(FR_Z) &trans         &trans  &trans   &kp UP   &trans    &kp PAGE_UP   &trans
    &trans  &trans  &trans   &kp LC(FR_X) &kp LC(FR_C) &kp LC(FR_V)   &trans  &kp LEFT &kp DOWN &kp RIGHT &kp PAGE_DOWN &trans
                             &trans       &trans       &trans         &trans  &trans   &trans
            >;
        };

        Raise {
            // -----------------------------------------------------------------------------------------
            // |       |  F1  |  F2  |  F3  |  F4  |  F5 |         |  F6  |  F7  |  F8  |  F9  | F10 |     |
            // |       |      |      | Vol -| Vol +| Play/Pause |  |      | Prev |      | Next |     |     |
            // | BTCLR | BT1  | BT2  | BT3  | BT4  | BT5 |         |      |      |      |      |     |     |
            //                          |     |     |    |         |      |      |      |
            label = "Raise";
            bindings = <
    &trans     &kp F1        &kp F2       &kp F3       &kp F4       &kp F5          &kp F6   &kp F7   &kp F8 &kp F9    &kp F10 &trans
    &trans     &kp C_PREV    &kp C_NEXT   &kp C_VOL_DN &kp C_VOL_UP &kp C_PP        &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
    &bt BT_CLR &bt BT_SEL 0  &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &trans   &trans   &trans &trans    &trans &trans
                          	                        &trans   &trans   &trans       &trans   &trans   &trans
            >;
        };

        Dev {
            // -----------------------------------------------------------------------------------------
            // |      |  !  |  @  |  #  |  $  |    %     |   |  ^  |  &  |  *  |  (  |  )  |   \   |
            // |      |  1  |  2  |  3  |  4  |    5     |   |  -  |  =  |  `  |  [  |  ]  |  "|"  |
            // |      |  6  |  7  |  8  |  9  |    0     |   |  _  |  +  |  ~  |  {  |  }  | RSHFT |
            //                     | GUI |     | ALT/ENT |   | HYPER/SPACE | BKSP |    |
            label = "Dev";
            bindings = <
    &kp FR_DLR   &kp FR_DQUO  &trans      &trans       &kp FR_LPRN  &kp FR_RPRN     &trans  &trans   &trans   &trans   &trans   &trans
    &kp FR_EXLM  &kp FR_AMPR  &kp FR_LABK &kp FR_RABK  &kp FR_LBRC  &kp FR_RBRC     &trans  &trans   &trans   &trans   &trans   &trans
    &kp FR_CIRC  &kp FR_PIPE  &kp FR_BSLS &kp FR_SLSH  &kp FR_LCBR  &kp FR_RCBR     &trans  &trans   &trans   &trans   &trans   &trans
                                          &trans       &kp FR_MINS  &trans          &trans  &trans   &trans
            >;
        };

        Num {
            // -----------------------------------------------------------------------------------------
            // |      |  !  |  @  |  #  |  $  |    %     |   |  ^  |  &  |  *  |  (  |  )  |   \   |
            // |      |  1  |  2  |  3  |  4  |    5     |   |  -  |  =  |  `  |  [  |  ]  |  "|"  |
            // |      |  6  |  7  |  8  |  9  |    0     |   |  _  |  +  |  ~  |  {  |  }  | RSHFT |
            //                     | GUI |     | ALT/ENT |   | HYPER/SPACE | BKSP |    |
            label = "Num";
            bindings = <
    &trans  &trans   &trans   &trans   &trans   &trans         &kp FR_EURO &kp FR_7 &kp FR_8 &kp FR_9 &kp FR_SLSH &trans
    &trans  &trans   &trans   &trans   &trans   &trans         &kp FR_HASH &kp FR_4 &kp FR_5 &kp FR_6 &kp FR_ASTR &kp FR_EQL
    &trans  &trans   &trans   &trans   &trans   &trans         &kp FR_PERC &kp FR_1 &kp FR_2 &kp FR_3 &kp FR_MINS &trans
                              &trans   &trans   &trans         &trans   &kp FR_PLUS  &trans
            >;
        };

        Game {
            label = "Game";
            bindings = <
    &kp ESC  &kp FR_A &kp FR_Z  &kp FR_E     &kp FR_R  &kp FR_T    &trans  &trans      &kp KC_UP    &trans       &trans   &kp KC_BSPC
    &kp TAB  &kp FR_Q &kp FR_S  &kp FR_D     &kp FR_F  &kp FR_G    &trans  &kp KC_LEFT &kp KC_DOWN  &kp KC_RIGHT &trans   &kp KC_RCTL
    &kp LSFT &kp FR_W &kp FR_X  &kp FR_C     &kp FR_V  &kp FR_B    &trans  &trans      &trans       &trans       &kp KC_RSFT
                                &kp LEFT_ALT &kp LCTL  &kp KC_ENT  &kp KC_SPC  &kp KC_ENT  &kp KC_RALT
            >;
        };

        Game_++ {
            label = "Game ++";
            bindings = <
    &kt F5  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp LC(RA(Y))  &kp LC(RA(U))  &kp LC(RA(I))  &kp LC(RA(H))  &kp LC(RA(J))  &kp LC(RA(DEL))
    &to 3         &kp L         &kp O         &kp Y         &kp K         &kp G           &trans         &trans         &trans         &trans         &trans       &kp LA(F4)
    &kp F10         &none         &to 0         &none  &kp NUMBER_6  &kp NUMBER_7           &trans         &trans         &trans         &trans         &trans            &to 0
                                            &kp J         &kp I         &kp M           &trans         &trans         &trans
            >;
        };
    };
};

&nice_view_spi {
    cs-gpios = <&pro_micro 0 GPIO_ACTIVE_HIGH>;
};